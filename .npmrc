legacy-peer-deps=true
# pnpm store/cache/state 固定到项目内（Windows 开发机，避免写入系统盘/D 盘根目录，且与 node_modules 链接一致）
store-dir=D:\projects\Hermes-Studio\.pnpm-store
cache-dir=D:\projects\Hermes-Studio\.pnpm-cache
state-dir=D:\projects\Hermes-Studio\.pnpm-state
# npm 级缓存（prebuild-install/node-gyp 下载预编译二进制）也收拢到项目内，避免沙箱禁止写系统盘
cache=D:\projects\Hermes-Studio\.npm-cache


